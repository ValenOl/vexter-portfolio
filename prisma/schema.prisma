// Task 1.4 (fiscal-assistant-mvp): tabla para los chunks embebidos del corpus
// de normativa. `text-embedding-004` (Vertex AI) devuelve vectores de 768
// dimensiones -- ver openspec/changes/fiscal-assistant-mvp/design.md.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

// Prisma 7: la URL de conexión ya NO va acá -- vive en prisma.config.ts
// (para Migrate) y se pasa como driver adapter a PrismaClient (para la
// app) -- ver src/lib/prisma.ts. Ver https://pris.ly/d/prisma7-client-config
datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

// Una fila por ficha del corpus (data/normativa/*.md) -- sin chunking
// adicional en el MVP, cada ficha ya es un chunk atómico (ver design.md,
// Decision: "Vector store, pgvector en Neon").
model NormativaChunk {
  id          String                 @id @default(cuid())
  ficha       String                 @unique // nombre de archivo, ej "factura-c"
  norma       String                 // ej "RG 4.309 y modificatorias"
  contenido   String                 // texto completo de la ficha
  fechaCorte  DateTime               @map("fecha_corte")
  embedding   Unsupported("vector(768)")
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")

  @@map("normativa_chunks")
}

// Observabilidad de guardrails (portfolio): una fila por decisión final del
// asistente, sea que dispare o no un guardrail. Objetivo: convertir "confío
// en que los guardrails funcionan" en evidencia consultable, no solo texto
// en openspec/redteam-report.md. Loggeada desde finalizeOutcome (único
// punto donde convergen ambos turnos del wizard, ver fiscal-assistant.ts) y
// desde el early-return de retrieval vacío en askFiscalAssistant.
model GuardrailEvent {
  id                 String   @id @default(cuid())
  origen             String // 'inicial' | 'continuacion' (pregunta vs respuesta a askUser)
  textoEvaluado      String   @map("texto_evaluado")
  outcome            String // 'done' | 'needs_input' | 'sin_fuente'
  guardrailTriggered String?  @map("guardrail_triggered") // null | 'sin_retrieval' | 'sin_citacion' | 'grounding_fallido'
  fichasDisponibles  Int      @default(0) @map("fichas_disponibles")
  fichasCitadas      String[] @map("fichas_citadas")
  createdAt          DateTime @default(now()) @map("created_at")

  @@map("guardrail_events")
}
